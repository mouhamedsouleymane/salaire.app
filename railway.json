{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "Dockerfile"
    },
    "deploy": {
        "startCommand": "php artisan serve --host=0.0.0.0 --port=8000",
        "healthcheckPath": "/",
        "healthcheckTimeout": 300
    },
    "plugins": [
        {
            "name": "mysql"
        }
    ]
}
